# Backend local — após mudar, reinicie o Vite (`npm run dev`).
# Precedência no dev: .env → .env.local → este arquivo → .env.development.local (máxima prioridade).
# Para testar o backend DEV na Vercel sem rodar localhost:3001, use .env.development.local com:
#   VITE_API_BASE_URL=https://suse7-backend-dev.vercel.app
# Base sem barra final (buildApiUrl acrescenta /api/...).
VITE_API_BASE_URL=http://localhost:3001

